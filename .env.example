# Forms are emailed by the Netlify Function in netlify/functions/submit.mjs via Resend.
# Set these in Netlify → Project configuration → Environment variables (not in this file):
#   RESEND_API_KEY=re_...
#   FORMS_TO=bookings@aluluthoinpractice.co.za
#   FORMS_FROM=Alulutho Xanywa Website <website@aluluthoinpractice.co.za>

# Set to true to make forms succeed without sending anything (on by default in .env.development).
VITE_FORMS_DEMO=false
